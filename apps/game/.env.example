# Public URL only. Use your computer's LAN address when running on a phone.
VITE_API_URL=http://localhost:3000/api/v1

# Supabase public project settings (never a service-role/secret key).
# Copy the URL and publishable key generated by pnpm supabase:env into .env.local.
# On phones, replace 127.0.0.1 with your computer's LAN address.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
