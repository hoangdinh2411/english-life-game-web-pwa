# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:8081,http://localhost:8082

# Optional API abuse throttling: set BOTH to approved positive integers to enable.
# API_RATE_LIMIT_MAX=<requests per connection IP per window>
# API_RATE_LIMIT_WINDOW_MS=<window duration in milliseconds>
# No default cap; unrelated to energy or daily free-chat policies.

# Database supplied by local Supabase (supabase:env generates these settings).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth token verification (R1); protected routes require URL and key.
# Run supabase:start and supabase:env to generate local settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server/upload tooling only. Never put this in VITE_* or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
# Real local integration is opt-in; do not point these at a hosted project.
TEST_SUPABASE_ENABLED=false
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI reply adapter (server only, never in the client). Only mock is supported.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# Legacy examples only: unresolved policies, not implemented or activated in T1
ENERGY_MAX=100
ENERGY_REFILL_PER_HOUR=10
FREE_CHAT_DAILY_CAP=30

# Server-only starter grant, in whole dollars; existing characters are unchanged.
STARTING_BALANCE=500
