{
  "intents": [
    {
      "id": "deny",
      "pattern": "^(?:no\\b|not really\\b|that(?:'s| is) not\\b)|\\b(?:don't|do not|didn't|did not|not) (?:need|want|mean)\\b"
    },
    {
      "id": "goodbye",
      "pattern": "\\b(?:bye|goodbye|see you)\\b"
    },
    {
      "id": "confirm",
      "pattern": "^(?:yes|yeah|yep|sure|exactly|of course|please|that(?:'s| is) right|i need it|i want it)\\b"
    },
    {
      "id": "thank",
      "pattern": "\\b(?:thanks|thank you)\\b"
    },
    {
      "id": "greet",
      "pattern": "\\b(?:hello|hi|hey|good morning|good afternoon|good evening)\\b"
    }
  ]
}
